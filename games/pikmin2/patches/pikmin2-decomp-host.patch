+#ifdef PIKI_PC_PORT
+// Parameter files (e.g. the cave AutoBgm conductors) are big-endian and
+// JSUInputStream::read copies bytes verbatim. Multi-byte values are turned
+// into host order here; single bytes and strings need nothing.
+template <typename T>
+inline void pcPrmFromDisk(T& value)
+{
+	if (sizeof(T) == 2) {
+		u16 raw;
+		__builtin_memcpy(&raw, &value, 2);
+		raw = __builtin_bswap16(raw);
+		__builtin_memcpy(&value, &raw, 2);
+	} else if (sizeof(T) == 4) {
+		u32 raw;
+		__builtin_memcpy(&raw, &value, 4);
+		raw = __builtin_bswap32(raw);
+		__builtin_memcpy(&value, &raw, 4);
+	}
+}
+#endif
+
 /**
  * @size = 0x30
  */
