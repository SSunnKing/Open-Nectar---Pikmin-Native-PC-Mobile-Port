+template <typename T>
+inline bool operator!=(TValueIterator<TParseValue_misaligned<T>, sizeof(T)> a, TValueIterator<TParseValue_misaligned<T>, sizeof(T)> b)
+{
+	return !(a == b);
+}
+template <typename T>
+inline TValueIterator<TParseValue_misaligned<T>, sizeof(T)> operator+(TValueIterator<TParseValue_misaligned<T>, sizeof(T)> a, s32 b)
+{
+	TValueIterator<TParseValue_misaligned<T>, sizeof(T)> it(a);
+	it += b;
+	return it;
+}
+template <typename T>
+inline std::ptrdiff_t operator-(TValueIterator<TParseValue_misaligned<T>, sizeof(T)> a, TValueIterator<TParseValue_misaligned<T>, sizeof(T)> b)
+{
+	return (a.mBegin - b.mBegin) / sizeof(T);
