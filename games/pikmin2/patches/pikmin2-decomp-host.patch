+#ifdef PIKI_PC_PORT
+// FPS Mode del port (60/120): la partida avanza mas ticks por segundo con
+// deltaTime proporcional. Lo que en el juego cuenta frames en vez de tiempo
+// (temporizadores, retrasos, probabilidades por frame, particulas) solo debe
+// avanzar en los ticks que habria tenido a su frecuencia original: 30 Hz en
+// partida, 60 en menus. PC_ORIG_TICK() es true exactamente en esos ticks.
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int gPcOrigTick;
