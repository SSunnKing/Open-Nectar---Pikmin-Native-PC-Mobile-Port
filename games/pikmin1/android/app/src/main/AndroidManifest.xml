<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Launcher: portadas (GameTDB) y aviso de versiones nuevas (GitHub). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Online co-op: the default route (gateway) for port mapping. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Netplay: WifiLock de baja latencia (sin el ahorro de energía de la Wi-Fi). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Carpeta de datos visible (issue #176): juegos, partidas y mods en el
         almacenamiento interno, abiertos con fopen. Android 11+ usa el
         acceso a todos los archivos; Android 10, el permiso clásico. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true">
        <!-- Permite medir rendimiento con simpleperf desde adb (sin depurador). -->
        <profileable android:shell="true" />

        <!-- SDLActivity pisa screenOrientation del manifest con lo que diga
             este hint (sin él deja la rotación libre y el juego se estira en
             vertical). -->
        <meta-data android:name="SDL_ENV.SDL_IOS_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />
        <!-- SDL expone el acelerómetro como un joystick; no queremos que el
             juego lo tome por un mando. -->
        <meta-data android:name="SDL_ENV.SDL_ACCELEROMETER_AS_JOYSTICK" android:value="0" />

        <!-- Entrada: comprueba la carpeta de datos (permiso, elegirla y
             trasladar lo anterior) y pasa al launcher. -->
        <activity android:name="org.opennectar.StartActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El launcher (hub Pikmin / Pikmin 2). Instala cada juego desde su
             disco y abre NectarActivity con el elegido. -->
        <activity android:name="org.opennectar.LauncherActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <!-- Instalador anterior (solo Pikmin 1). Ya no es la entrada de la app. -->
        <activity android:name="org.opennectar.InstallerActivity"
            android:label="@string/app_name"
            android:exported="false" />

        <!-- El juego va en su propio proceso: SDL2 no se puede reiniciar en el
             mismo proceso que ya usó el launcher (también es SDL). -->
        <activity android:name="org.opennectar.NectarActivity"
            android:process=":game"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false" />
    </application>
</manifest>
